{
  "name": "roadgen3d-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host ${ROADGEN_VIEWER_HOST:-127.0.0.1} --port ${ROADGEN_VIEWER_PORT:-4173} --strictPort",
    "build": "tsc -b && vite build",
    "capture:gallery": "node scripts/capture-gallery.mjs",
    "test:i18n:contract": "node tests/viewer-i18n-contract.test.mjs",
    "test:i18n:routes": "node tests/viewer-i18n.test.mjs && node tests/model-input-browser.test.mjs",
    "test:i18n": "npm run test:i18n:contract && npm run test:i18n:routes",
    "test:plan-export": "node tests/plan-export.test.mjs",
    "test:surface-diagnostic": "node tests/surface-diagnostic.test.mjs",
    "test:annotation-viewport": "node tests/annotation-viewport.test.mjs",
    "test:osm-aoi-picker": "node tests/osm-aoi-picker.test.mjs",
    "test:professional-navigation": "node tests/professional-navigation.test.mjs",
    "test:professional-pipeline": "node tests/professional-pipeline.test.mjs",
    "test:professional-draft": "node tests/professional-annotation-draft.test.mjs",
    "test:generation-wizard": "node tests/generation-wizard.test.mjs",
    "test:starter-scene": "node tests/starter-scene.test.mjs",
    "test:single-left-shell": "node tests/single-left-shell.test.mjs",
    "test:scene-edit-loop": "node tests/scene-edit-loop.test.mjs",
    "test:course-failure": "node tests/course-generation-failure.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ant-design/icons": "^6.2.2",
    "@antv/g6": "^5.1.0",
    "antd": "^6.3.7",
    "chart.js": "^4.5.1",
    "chartjs-plugin-annotation": "^3.1.0",
    "maplibre-gl": "^5.24.0",
    "polygon-clipping": "^0.15.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright": "^1.59.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
